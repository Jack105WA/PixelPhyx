{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "js",
    "outDir": "js",
    "noCheck": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "js/**/*.ts"
  ],
  "exclude": [
    "pkg"
  ]
}
