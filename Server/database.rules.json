
{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "lobbyDirectory": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null"
      }
    },

    "lobbySlots": {
      ".read": "auth != null",
      "$slot": {
        ".write": "auth != null"
      }
    },

    "serviceStatus": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
